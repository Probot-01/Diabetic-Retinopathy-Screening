# NetraSetu central backend (central-system/backend) -- configuration template.
#
# Copy to central-system/backend/.env (scripts/dev-up does this for you on first
# run) and fill in the blanks. .env is git-ignored; this file is committed and
# must never hold a real secret. Read by loadEnv.js: the real environment wins,
# then this service's .env, then the older shared <repo root>/.env.
#
# Every variable this service reads is listed. Commented-out lines show the
# built-in default and only need uncommenting to change it.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# production hides internal error messages from 500 responses.
NODE_ENV=development

# ── Postgres ─────────────────────────────────────────────────────────────────
# docker-compose.dev.yml publishes Postgres on host port 5433 (not 5432, so it
# never collides with a Postgres already installed on the machine).
DATABASE_URL=postgresql://netrasetu:netrasetu_dev@localhost:5433/dr_screening_central
# Alternative to DATABASE_URL (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=dr_screening_central
# PGUSER=postgres
# PGPASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API, comma-separated. Credentials are on
# (session cookie), so '*' is refused at startup. Unset = the two local dev
# frontends only (http://localhost:5173 and :5174). A hosted frontend must be
# listed, e.g. https://netrasetu.vercel.app or the pattern https://*.vercel.app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Auth (backend plan §A) ───────────────────────────────────────────────────
# Enforce browser logins for ophthalmologist / district_admin routes.
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length in hours, (0, 24]. No refresh tokens.
# JWT_TTL_HOURS=12
# lax for a same-site frontend; none when the frontend is on another site
# (e.g. a *.vercel.app page calling this machine), which also forces Secure.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# Minutes a reviewer's claim on a case holds before someone else may take it.
# CLAIM_TTL_MINUTES=30
# Require X-PHC-Api-Key on PHC ingestion routes. Keys come from scripts/seed-demo.js
# (local dev) or `npm run provision-phc-key` (a real site).
PHC_AUTH_ENABLED=false

# ── TLS (§A.14) ──────────────────────────────────────────────────────────────
# Both set = HTTPS only. `node scripts/generateDevCert.js` makes a self-signed pair.
# TLS_KEY_PATH=
# TLS_CERT_PATH=

# ── Demo accounts (scripts/seed-demo.js, scripts/seedDemoUsers.js) ───────────
# Passwords for the two seeded users. Unset = a random password is generated
# and printed once by seed-demo.js.
DEMO_OPHTHALMOLOGIST_PASSWORD=
DEMO_ADMIN_PASSWORD=

# ── Inference engines ────────────────────────────────────────────────────────
# Forward slashes deliberately: Windows accepts them, and they survive .env
# parsers and MATLAB string literals. Unset = `matlab` on PATH.
MATLAB_EXECUTABLE=
# Branch A classifier: matlab (default) | python
INFERENCE_BACKEND=matlab
# Lesion segmentation: matlab (default) | python
# SEG_INFERENCE_BACKEND=matlab
# Python used for the ML pipeline (conda env with ml-pipeline/requirements.txt).
PYTHON_EXECUTABLE=python
# One-shot `matlab -batch` timeout.
# MATLAB_TIMEOUT_MS=120000
# 0 = a missing MATLAB fails the case instead of substituting the JS
# re-implementation. Default (unset) ALLOWS the substitution -- see the
# session report before relying on it.
# MATLAB_ALLOW_FALLBACK=
# Persistent MATLAB session (ml-pipeline/inference/matlabSession).
# MATLAB_SESSION_DIR=
# MATLAB_SESSION_TIMEOUT_MS=30000
# MATLAB_CASE_PIPELINE_TIMEOUT_MS=120000
# MATLAB_HEARTBEAT_PATH=
# Python segmentation worker session.
# SEG_SESSION_DIR=
# SEG_SESSION_TIMEOUT_MS=120000
# SEG_HEARTBEAT_PATH=

# ── Grading queue (in-process; no Redis) ─────────────────────────────────────
# GRADING_CONCURRENCY=1
# GRADING_MAX_ATTEMPTS=3
# GRADING_RETRY_BASE_MS=2000

# ── Reliability (backend plan §D-§F) ─────────────────────────────────────────
# GRADING_WATCHDOG_INTERVAL_MS=90000
# WATCHDOG_MIN_AGE_SECONDS=120
# WATCHDOG_MAX_RECOVERIES=3
# MATLAB session supervisor: on whenever a MATLAB engine is selected. It also
# STARTS the session when this backend boots.
# MATLAB_SUPERVISOR_ENABLED=true
# MATLAB_SUPERVISOR_INTERVAL_MS=30000
# MATLAB_HEARTBEAT_STALE_MS=30000
# MATLAB_STARTUP_GRACE_MS=240000
# MATLAB_MAX_RESTARTS=3
# MATLAB_RESTART_WINDOW_MS=1800000
# SEG_WORKER_SUPERVISOR_ENABLED=true
# SEG_SUPERVISOR_INTERVAL_MS=30000
# SEG_HEARTBEAT_STALE_MS=30000
# SEG_STARTUP_GRACE_MS=90000
# SEG_MAX_RESTARTS=3
# SEG_RESTART_WINDOW_MS=1800000
# System Health thresholds (§F).
# SILENT_PHC_HOURS=48
# STUCK_JOB_MINUTES=15
# UNREVIEWED_CASE_HOURS=48

# ── Chunked upload (Task 8.2) ────────────────────────────────────────────────
# UPLOAD_MAX_CHUNK_BYTES=4194304
# UPLOAD_MAX_TOTAL_BYTES=67108864
# UPLOAD_MAX_CHUNKS=2048
# UPLOAD_SESSION_TTL_MS=604800000

# ── District resource model and Simulink validation (§G) ─────────────────────
# REPORT_TIMEZONE=Asia/Kolkata
# RESOURCE_MODEL_CRON=30 2 * * *
# RESOURCE_MODEL_TIMEOUT_MS=600000
# RESOURCE_MODEL_ANNUAL_PATIENTS=
# SIMULINK_VALIDATION_ENABLED=true
# SIMULINK_VALIDATION_CRON=0 3 * * 0
# SIMULINK_VALIDATION_TIMEOUT_MS=1200000
# SIMULINK_VALIDATION_PATH=

# ── Retraining trigger ───────────────────────────────────────────────────────
# RETRAIN_THRESHOLD=20
# RETRAIN_SCHEDULE=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# 1 = log messages instead of sending them. Leave 1 for local dev.
SMS_DRY_RUN=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public https URL of POST /api/v1/notifications/sms-status; must match exactly
# (Twilio signs it). Unset = only immediate send failures are caught.
# TWILIO_STATUS_CALLBACK_URL=
REFERRAL_CLINIC_NAME=
