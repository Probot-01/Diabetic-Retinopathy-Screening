# NetraSetu central frontend (ophthalmologist + district admin) -- Vite env.
# Copy to central-system/frontend/.env (scripts/dev-up does this on first run).
# Restart `npm run dev` after editing.

# Dev-server proxy target: /api and /media on this app's origin are forwarded
# here, so the browser sees ONE origin, as it will behind a reverse proxy in
# deployment. Not exposed to the browser bundle.
CENTRAL_API_PROXY_TARGET=http://localhost:5000

# Leave EMPTY for same-origin (the setup above, and production behind a
# reverse proxy). Set a full URL only when this frontend is hosted on a
# different origin from the backend (then the backend needs
# COOKIE_SAMESITE=none and this origin in CORS_ALLOWED_ORIGINS).
VITE_CENTRAL_API_BASE=

# live (default) | mock
#   live  real login; every screen calls the API; a failure shows an error,
#         never mock data.
#   mock  fixture data only, demo login, a permanent "DEMO DATA" banner.
VITE_DATA_MODE=live
# Dev-server port; set it only to run a second checkout beside this one (default 5174).
# CENTRAL_WEB_PORT=5174
