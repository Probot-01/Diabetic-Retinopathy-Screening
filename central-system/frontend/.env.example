# NetraSetu central frontend (ophthalmologist + district admin) -- Vite env.
# Copy to central-system/frontend/.env (scripts/dev-up does this on first run).
# VITE_* values are inlined at build time: restart `npm run dev` after editing.

# Base URL of central-system/backend. Required in live mode; there is no
# built-in default, and a missing value is shown as an error on screen.
# The backend's CORS_ALLOWED_ORIGINS must include this app's origin
# (http://localhost:5174 in dev).
VITE_CENTRAL_API_BASE=http://localhost:5000

# live (default) | mock
#   live  every screen calls the API; a failure shows an error, never mock data.
#   mock  fixture data only, with a permanent "DEMO DATA" banner. No backend needed.
VITE_DATA_MODE=live
