# NetraSetu PHC mobile app. Copy to .env and fill in. EXPO_PUBLIC_* values are
# inlined at build time; each can also be changed on the device in
# Menu -> Device Settings, which wins over these defaults.

# The CENTRAL backend (central-system/backend), not the PHC PC's local backend.
# Android emulator -> host machine: http://10.0.2.2:5000
# Physical phone on the same Wi-Fi: http://<laptop LAN IP>:5000
EXPO_PUBLIC_CENTRAL_API_URL=http://10.0.2.2:5000

# This site's key from `npm run provision-phc-key` on central. Central now runs
# with PHC_AUTH_ENABLED=true, so it is required. EXPO_PUBLIC_* values are compiled
# into the app bundle: for a RELEASE build leave this empty and enter the key on
# the phone (Menu -> Device settings), where it is kept in the OS keystore.
EXPO_PUBLIC_PHC_API_KEY=

# Expo Go (SDK 57) swaps the global fetch for expo/fetch, which cannot send this app's
# multipart image upload ("Cannot reach the central server" with no request reaching the
# server). This makes the app use React Native's own fetch. Keep it set.
EXPO_PUBLIC_USE_RN_FETCH=1

# Prefix of every patient/capture ID minted on this phone (docs/id-format-spec.md).
# Must be unique per PHC.
EXPO_PUBLIC_PHC_CODE=PHC001
EXPO_PUBLIC_PHC_NAME=PHC Kharadi

# Technician accounts, "username:password:Display Name" comma-separated.
# Unset -> one demo account, technician / tech123, shown on the login screen.
# EXPO_PUBLIC_TECHNICIANS=asha:1234:Asha Patil,ravi:5678:Ravi Shinde
