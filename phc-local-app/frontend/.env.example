# NetraSetu PHC desktop frontend (technician station) -- Vite env.
# Copy to phc-local-app/frontend/.env (scripts/dev-up does this on first run).
# VITE_* values are inlined at build time: restart `npm run dev` after editing.

# Base URL of phc-local-app/backend (this PC's local API). Required in live
# mode; there is no built-in default, and a missing value is shown as an
# error on screen. The local backend's CORS_ALLOWED_ORIGINS must include this
# app's origin (http://localhost:5173 in dev).
VITE_LOCAL_API_BASE=http://localhost:4000

# live (default) | mock
#   live  every screen calls the local backend; a failure shows an error,
#         never mock data or an invented quality result.
#   mock  fixture data only, with a permanent "DEMO DATA" banner. No backend needed.
VITE_DATA_MODE=live

# Name shown in the header. Label only.
VITE_PHC_NAME=PHC Kharadi
